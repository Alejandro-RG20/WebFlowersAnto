# =====================================================================
#  Flowers Anto — configuración de Apache
#
#  Ojo al tocar este archivo: una sola directiva no admitida aquí tumba
#  el sitio entero con un «Error interno del servidor», sin más pistas
#  que el registro de errores de Apache. Todo lo que dependa de un módulo
#  va envuelto en <IfModule>, y las directivas que solo valen en la
#  configuración principal (como <Directory>) no aparecen.
# =====================================================================

DirectoryIndex index.php index.html

# --- Nada de listados de directorio ----------------------------------
Options -Indexes

# --- Archivos que nunca deben servirse -------------------------------
<FilesMatch "^(\.env.*|config\.local\.php|composer\.(json|lock)|.*\.md|.*\.sql)$">
  Require all denied
</FilesMatch>

# --- Carpetas internas ------------------------------------------------
# Los comprobantes, los respaldos y el código no se sirven nunca por URL.
RedirectMatch 404 ^/(.*/)?(storage|includes|db)/
RedirectMatch 404 ^/(.*/)?\.git

# La protección de uploads/ vive en uploads/.htaccess: <Directory> no se
# admite en un .htaccess y usarlo aquí devuelve un error 500.

# --- Cabeceras de seguridad ------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header unset X-Powered-By
</IfModule>

# --- Caché de estáticos ------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg  "access plus 30 days"
  ExpiresByType image/png   "access plus 30 days"
  ExpiresByType image/webp  "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/css    "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>

# --- Compresión --------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
</IfModule>

# --- Página de error 404 ------------------------------------------------
# La ruta es absoluta desde la raíz del dominio, así que solo se puede
# activar cuando se sabe dónde está instalado el sitio:
#
#   en la raíz del dominio      ->  ErrorDocument 404 /404.php
#   en htdocs/webANTO (XAMPP)   ->  ErrorDocument 404 /webANTO/404.php
#
# Descoméntala con la ruta que corresponda. Si se deja mal, el navegador
# muestra un error doble bastante confuso, así que viene desactivada.
# ErrorDocument 404 /404.php
