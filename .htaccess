# =====================================================================
#  Flowers Anto — configuración de Apache
#
#  Ojo al tocar este archivo: una sola directiva no admitida aquí tumba
#  el sitio entero con un «Error interno del servidor», sin más pistas
#  que el registro de errores de Apache. Todo lo que dependa de un módulo
#  va envuelto en <IfModule>, y las directivas que solo valen en la
#  configuración principal (como <Directory>) no aparecen.
# =====================================================================

DirectoryIndex index.php index.html

# --- Nada de listados de directorio ----------------------------------
Options -Indexes

# --- Todo por HTTPS ---------------------------------------------------
# Sin esto, quien entre por http:// manda su contraseña y su dirección en
# claro, y la cookie de sesión pierde el atributo `secure`.
#
# Se comprueban dos cosas porque en un hosting compartido el certificado suele
# terminar en un balanceador: ahí %{HTTPS} llega «off» aunque el visitante sí
# venga por https, y la cabecera X-Forwarded-Proto es la que dice la verdad.
# Sin la segunda condición se entraría en un bucle de redirecciones.
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # robots.txt lo genera PHP para que la dirección del sitemap lleve siempre el
  # dominio real: escrita a mano se quedaba vieja al cambiar de dominio, y un
  # sitemap que apunta a otro sitio es un sitemap que Google no llega a leer.
  #
  # Va DESPUÉS del salto a https a propósito: si fuera antes, una petición por
  # http se respondería tal cual en vez de redirigirse, y el archivo acabaría
  # sirviéndose por las dos direcciones.
  #
  # Si el servidor no permite reescrituras, no pasa nada: se sirve el
  # robots.txt de al lado, que dice lo mismo con el dominio escrito a mano.
  RewriteRule ^robots\.txt$ robots.php [L]
</IfModule>

# --- Archivos que nunca deben servirse -------------------------------
<FilesMatch "^(\.env.*|config\.local\.php|composer\.(json|lock)|.*\.md|.*\.sql)$">
  Require all denied
</FilesMatch>

# --- Carpetas internas ------------------------------------------------
# Los comprobantes, los respaldos y el código no se sirven nunca por URL.
RedirectMatch 404 ^/(.*/)?(storage|includes|db)/
# `storage/` incluye respaldos, comprobantes y la caché de fotos reducidas.
RedirectMatch 404 ^/(.*/)?\.git

# La protección de uploads/ vive en uploads/.htaccess: <Directory> no se
# admite en un .htaccess y usarlo aquí devuelve un error 500.

# --- Cabeceras de seguridad ------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header unset X-Powered-By
  Header unset Server

  # HSTS: una vez que el navegador ha entrado por https, no vuelve a intentar
  # http ni aunque escriban la dirección a mano.
  #
  # Iba con `env=HTTPS`, y en un hosting donde el certificado lo termina un
  # proxy por delante —el caso de casi todos los compartidos— esa variable no
  # llega nunca y la cabecera no salía. Se envía siempre: la especificación
  # obliga al navegador a ignorarla si la recibe por http, así que no hay
  # riesgo, y arriba ya se fuerza la redirección a https.
  #
  # Ojo: mientras esté puesto, el dominio queda atado a https durante un año
  # en los navegadores que ya lo hayan visto. Con el certificado en su sitio
  # —hoy lo dan gratis todos los hostings— no hay ningún problema.
  #
  # No se añade `preload`: entrar en esa lista es fácil y salir tarda meses.
  # Es una decisión del dueño del dominio, no algo que deba activarse solo.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# --- Caché de estáticos ------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg  "access plus 30 days"
  ExpiresByType image/png   "access plus 30 days"
  ExpiresByType image/webp  "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/avif  "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType font/woff2  "access plus 1 year"
  # El CSS y el JS llevan la fecha del archivo en la URL (app.js?v=1788…), así
  # que la dirección cambia sola al publicar una versión nueva. Por eso pueden
  # guardarse un año: el navegador nunca sirve uno viejo por error.
  ExpiresByType text/css    "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

# --- Compresión --------------------------------------------------------
# El paquete de CSS se genera ya comprimido junto al normal. Si el navegador
# acepta gzip y la copia existe, se le manda esa. Hace falta mod_headers para
# anunciar la codificación, así que la regla entera vive dentro de su IfModule:
# sin él no se reescribe nada y se sirve la hoja normal, que siempre está.
<IfModule mod_headers.c>
  <IfModule mod_rewrite.c>
    RewriteCond %{HTTP:Accept-Encoding} gzip
    RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.gz -f
    RewriteRule ^(assets/dist/.+\.css)$ $1.gz [QSA,L]
  </IfModule>
  <FilesMatch "\.css\.gz$">
    Header set Content-Encoding gzip
    Header append Vary Accept-Encoding
    # Sin esto el navegador recibiría el paquete como application/gzip y no
    # lo aplicaría como hoja de estilos.
    ForceType text/css
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  # Los SVG son texto y se comprimen a menos de un tercio.
  AddOutputFilterByType DEFLATE image/svg+xml application/xml
  AddOutputFilterByType DEFLATE font/woff2 application/font-woff
</IfModule>

# --- Página de error 404 ------------------------------------------------
# `ErrorDocument` necesita una ruta absoluta desde la raíz del DOMINIO, y esa
# ruta cambia según dónde esté instalado el sitio (raíz del dominio, o una
# subcarpeta tipo /webANTO en XAMPP). Puesta mal, el navegador enseña un error
# doble bastante confuso, así que aquí no se usa.
#
# La reescritura sí se resuelve relativa a la carpeta donde vive este archivo,
# de modo que acierta en los dos casos sin tener que editarla al desplegar.
# `404.php` manda su propio `http_response_code(404)`, así que el estado que
# ven el navegador y Google sigue siendo un 404 de verdad, no un 200 disfrazado
# con cara de error.
<IfModule mod_rewrite.c>
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  # Un archivo estático que falta se queda con el 404 seco de Apache: no
  # merece la pena arrancar PHP y abrir la base de datos para pintar una
  # página que nadie va a leer. En un hosting compartido, un robot pidiendo
  # rutas al azar se llevaría por delante el límite de procesos.
  RewriteCond %{REQUEST_URI} !\.(css|js|map|json|xml|txt|png|jpe?g|gif|webp|avif|svg|ico|woff2?|ttf|eot|mp4|webm)$ [NC]
  # Sin esta línea, si algún día falta 404.php la regla se llamaría a sí misma.
  RewriteCond %{REQUEST_URI} !404\.php$
  RewriteRule ^ 404.php [L]
</IfModule>
