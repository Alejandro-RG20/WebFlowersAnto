# =====================================================================
#  Flowers Anto — plantilla de variables de entorno
#  Copia este archivo como `.env` y ajusta los valores.
#  `.env` está en .gitignore: nunca subas secretos al repositorio.
# =====================================================================

# --- Entorno ---------------------------------------------------------
# prod = oculta los errores y envía los correos de verdad. Es el valor que
#        debe quedar en el servidor: este archivo se copia tal cual al
#        desplegar, y dejar «dev» aquí es lo que hizo que un cliente viera
#        un aviso de PHP impreso encima del catálogo.
# dev  = muestra los errores en pantalla y manda los correos a storage/logs.
#        Solo surte efecto si la petición viene de la propia máquina o de la
#        red local; en un dominio público se ignora y se usa prod.
APP_ENTORNO=prod

# Ruta del sitio dentro del dominio.
# XAMPP en htdocs/webANTO -> /webANTO      dominio propio en la raíz -> (vacío)
APP_BASE_URL=

# URL pública completa. Necesaria para los enlaces de los correos y
# para el callback de Google. Sin barra final.
APP_URL=http://localhost:8000

# --- Base de datos ---------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=flowers_anto
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# --- Subidas ---------------------------------------------------------
# Tamaño máximo de imagen de catálogo, en megabytes
MAX_UPLOAD_MB=5
# Tamaño máximo de comprobante de pago (JPG/PNG/WEBP/PDF), en megabytes
MAX_COMPROBANTE_MB=8
# Tamaño máximo de archivo de respaldo que se puede subir, en megabytes
MAX_RESPALDO_MB=64

# --- Google OAuth ----------------------------------------------------
# Consola: https://console.cloud.google.com/apis/credentials
# URI de redirección autorizada: {APP_URL}/cuenta/google-callback.php
# Si se dejan vacíos, el botón "Continuar con Google" no se muestra.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Facebook Login --------------------------------------------------
# Meta for Developers: https://developers.facebook.com/apps
# URI de redireccionamiento de OAuth válida: {APP_URL}/cuenta/facebook-callback.php
# Requiere la migración 023 (Admin → Base de datos). Si se dejan vacíos, o
# falta la migración, el botón "Continuar con Facebook" no se muestra.
# El secreto de la app solo vive aquí, en el servidor: nunca en el navegador.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Opcional. Versión de la Graph API (por defecto v23.0).
FACEBOOK_GRAPH_VERSION=

# Solo desarrollo (APP_ENTORNO=dev): manda Google y Facebook al simulador
# local de tests/auth/simulador-oauth.js. En producción se ignora.
# OAUTH_SIMULADOR=http://127.0.0.1:8798

# --- Correo saliente -------------------------------------------------
# MAIL_TRANSPORTE: log | mail | smtp
#   log  -> escribe los correos en storage/logs/correos.log (desarrollo)
#   mail -> función mail() de PHP (hosting compartido)
#   smtp -> servidor SMTP propio (recomendado en producción)
MAIL_TRANSPORTE=log
MAIL_REMITENTE=no-responder@flowersanto.com
MAIL_REMITENTE_NOMBRE=Flowers Anto

SMTP_HOST=
SMTP_PORT=587
# SMTP_SEGURIDAD: tls | ssl | ninguna
SMTP_SEGURIDAD=tls
SMTP_USUARIO=
SMTP_PASSWORD=

# --- Respaldos -------------------------------------------------------
# Ruta a mysqldump. Si está vacío o no existe, se usa el volcador propio
# en PHP (funciona en cualquier hosting, sin acceso a consola).
MYSQLDUMP_BIN=

# --- Asistentes de IA (opcional) -------------------------------------
# Guía completa: docs/IA.md
# Sin clave, los asistentes no aparecen y la tienda funciona igual.
# Nunca subas la clave al repositorio ni la pongas en el JavaScript.
#
# Proveedor: anthropic (por defecto) | openrouter | google | openai
#   anthropic   Messages API de Anthropic. Clave: https://console.anthropic.com
#   openrouter  OpenRouter (API compatible con OpenAI). Clave: https://openrouter.ai/keys
#   google      Google Gemini (API oficial). Clave: https://aistudio.google.com/apikey
#   openai      Otra API compatible con OpenAI (indica AI_BASE_URL)
AI_PROVEEDOR=anthropic
AI_API_KEY=
# Vacío = la del proveedor (https://api.anthropic.com · https://openrouter.ai/api/v1 ·
# https://generativelanguage.googleapis.com).
# Al cambiar de proveedor, vacíala o pon la del nuevo. Solo https.
AI_BASE_URL=
# Modelo de la tienda y (si no se define AI_MODEL_ADMIN) del panel.
# Con anthropic, por defecto claude-opus-5. Con openrouter es OBLIGATORIO, con
# el identificador de OpenRouter, p. ej. nvidia/nemotron-3-ultra-550b-a55b:free
# Con google también es OBLIGATORIO, p. ej. gemini-2.5-flash-lite
AI_MODEL=claude-opus-5
AI_MODEL_ADMIN=
# 0 apaga cada asistente por separado sin quitar la clave.
AI_CLIENTE_ACTIVO=1
AI_ADMIN_ACTIVO=1
# Segundos máximos por respuesta (10 a 90).
AI_TIMEOUT=40
# Tope INTERNO de Flowers Anto: mensajes de clientes a la asesora por día en
# toda la tienda (0 = sin tope). No es el límite del proveedor: cada mensaje
# puede hacer 2 o más peticiones a la API (ver docs/IA.md).
AI_LIMITE_DIARIO=50
# Opcionales, solo OpenRouter: identifican la tienda en su panel.
# Datos públicos, nunca secretos. AI_APP_URL debe ser https.
AI_APP_URL=
AI_APP_NOMBRE=

# --- Ejemplo: Google Gemini ------------------------------------------
# Para usar Gemini, cambia las líneas de arriba por estas (la clave, en AI_API_KEY):
# AI_PROVEEDOR=google
# AI_API_KEY=
# AI_BASE_URL=https://generativelanguage.googleapis.com
# AI_MODEL=gemini-2.5-flash-lite
# AI_MODEL_ADMIN=gemini-2.5-flash-lite
# Las cuotas gratuitas de Google cambian según el modelo y el proyecto: el
# sistema no supone ninguna cifra y trata el 429 como «límite alcanzado».
