# --- Configuración local: nunca debe subirse -------------------------
.env
.env.*
!.env.example
config.local.php

# --- Datos del negocio, no código ------------------------------------
# Fotos subidas desde el panel. El .htaccess sí viaja: es la protección que
# impide que se ejecute código en esta carpeta, y sin él el proyecto se
# descargaría sin esa defensa.
uploads/*
!uploads/.gitkeep
!uploads/.htaccess

# Comprobantes de pago, respaldos y registros.
# Los .htaccess sí viajan: son la protección que impide descargarlos, y sin
# ellos el proyecto se desplegaría con los respaldos al aire.
storage/comprobantes/*
!storage/comprobantes/.gitkeep
!storage/comprobantes/.htaccess
storage/respaldos/*
!storage/respaldos/.gitkeep
!storage/respaldos/.htaccess
storage/logs/*
!storage/logs/.gitkeep
!storage/logs/.htaccess

# Sesiones: solo se usa esta carpeta si no se puede escribir fuera del
# directorio público. Son credenciales vivas, nunca se versionan.
storage/sesiones/
# Copias reducidas de las fotos: se regeneran solas, no se versionan.
storage/cache/img/*
!storage/cache/img/.gitkeep

# --- Respaldos sueltos ------------------------------------------------
*.sql.bak
respaldo*.sql
dump*.sql

# --- Archivos comprimidos --------------------------------------------
# El proyecto se sube como carpetas, no como .rar/.zip
*.rar
*.zip
*.7z
*.tar.gz

# --- Dependencias -----------------------------------------------------
node_modules/
vendor/

# --- Editores y sistema -----------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# --- Registros --------------------------------------------------------
*.log
error_log
php_errors.log

# Paquete de CSS generado: se regenera solo, no se versiona.
assets/dist/
